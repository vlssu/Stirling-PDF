{
  "name": "stirling-pdf-node",
  "version": "1.0.0",
  "description": "Stirling-PDF Node.js 版 — Vue 3 + Express + TypeScript 前后端一体化",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -n 服务端,客户端 -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json backend/src/app.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/app.js",
    "test:server": "jest --passWithNoTests",
    "test:client": "vitest run",
    "test": "npm run test:server && npm run test:client",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "element-plus": "^2.13.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "vue": "^3.5.32",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  }
}
